<ui:FluentWindow x:Class="WindowsTrayInvert.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:WindowsTrayInvert.Localization"
                 xmlns:app="clr-namespace:WindowsTrayInvert"
                 Title="{x:Static app:App.DisplayName}" Width="860" Height="680" MinWidth="460" MinHeight="400"
                 WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Height = caption button height, so icon, title, trailing controls and caption buttons share one row. -->
        <ui:TitleBar Grid.Row="0" Title="{x:Static app:App.DisplayName}" Height="32" Padding="12,0,0,0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app.ico" Width="16" Height="16" Margin="4,0,12,0" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <!-- Same row as the caption buttons (top aligned, their height) so the centers line up. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Height="{Binding ActualHeight, ElementName=ThemeButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <ComboBox x:Name="LanguageBox" MinWidth="120" MinHeight="0" Height="26" Padding="10,0" Margin="0,0,6,0"
                              FontSize="12" VerticalAlignment="Center" VerticalContentAlignment="Center"
                              DisplayMemberPath="NativeName" SelectionChanged="OnLanguageChanged"
                              ToolTip="{loc:Tr Language}" AutomationProperties.Name="{loc:Tr Language}"
                              WindowChrome.IsHitTestVisibleInChrome="True" />
                    <!-- Sized like a caption button (46 x 32). -->
                    <ui:Button x:Name="ThemeButton" Appearance="Transparent" BorderThickness="0" CornerRadius="0"
                               Width="46" Height="32" Padding="0" FontSize="14" VerticalAlignment="Top"
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnThemeClick"
                               WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,8,40,32" MaxWidth="1000">
                <TextBlock Text="{loc:Tr PageTitle}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />

                <ui:CardControl Margin="0,0,0,4">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Power24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr AutoStartHeader}" FontSize="14" />
                            <TextBlock Text="{loc:Tr AutoStartDescription}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="AutoStartToggle" Click="OnAutoStartClick" />
                </ui:CardControl>

                <ui:CardControl Margin="0,0,0,4">
                    <ui:CardControl.Icon>
                        <ui:SymbolIcon Symbol="Broom24" />
                    </ui:CardControl.Icon>
                    <ui:CardControl.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:Tr OrphanHeader}" FontSize="14" />
                            <TextBlock x:Name="OrphanText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:Button x:Name="OrphanButton" Content="{loc:Tr OrphanCleanButton}" MinWidth="96"
                               Click="OnOrphanCleanClick" />
                </ui:CardControl>

                <Grid Margin="0,28,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Tr AppIconsHeader}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{loc:Tr AppIconsDescription}" />
                    </StackPanel>
                    <ui:TextBox x:Name="SearchBox" Grid.Column="1" Width="220" Margin="12,0,8,0" VerticalAlignment="Center"
                                PlaceholderText="{loc:Tr SearchPlaceholder}" TextChanged="OnSearchChanged">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                    <!-- Bulk actions apply to the rows currently listed (after the search filter), with confirmation. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <ui:Button Icon="{ui:SymbolIcon Eye24}" Margin="0,0,4,0" Click="OnShowAllClick"
                                   ToolTip="{loc:Tr ShowAll}" AutomationProperties.Name="{loc:Tr ShowAll}" />
                        <ui:Button Icon="{ui:SymbolIcon EyeOff24}" Click="OnHideAllClick"
                                   ToolTip="{loc:Tr HideAll}" AutomationProperties.Name="{loc:Tr HideAll}" />
                    </StackPanel>
                    <ui:Button Grid.Column="3" VerticalAlignment="Center" ToolTip="{loc:Tr Refresh}" Click="OnRefreshClick"
                               AutomationProperties.Name="{loc:Tr Refresh}" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </Grid>

                <ItemsControl x:Name="IconList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Margin="0,0,0,4" Padding="16,10" ToolTip="{Binding ExecutablePath}">
                                <ui:CardControl.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Margin="0,0,16,0">
                                            <Grid>
                                                <ui:SymbolIcon Symbol="Apps24" FontSize="20">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <!-- Placeholder only when Explorer has no snapshot. -->
                                                                <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <Image Source="{Binding Image}" Width="24" Height="24"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ExecutablePath}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                        Visibility="{Binding IsOrphan, Converter={StaticResource BoolToVisibility}}">
                                                <ui:SymbolIcon Symbol="Warning16" FontSize="12" Margin="0,0,4,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                <TextBlock Text="{loc:Tr OrphanBadge}" FontSize="12"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Appearance="Transparent" BorderThickness="0" Padding="8" Margin="0,0,12,0"
                                               VerticalAlignment="Center" Icon="{ui:SymbolIcon FolderOpen24}"
                                               IsEnabled="{Binding CanOpenFolder}" Click="OnOpenFolderClick"
                                               ToolTip="{loc:Tr OpenFolder}" AutomationProperties.Name="{loc:Tr OpenFolder}" />
                                    <ui:ToggleSwitch VerticalAlignment="Center"
                                                     IsChecked="{Binding IsShown, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Name}" />
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="0,16" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr NoMatch}" />
            </StackPanel>
        </ScrollViewer>

        <!-- In-window dialogs (confirmations) are shown here, over the whole page. -->
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
